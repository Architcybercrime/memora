# ====== LLM ======
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# ====== Embeddings ======
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ====== Postgres (pgvector) ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora
POSTGRES_DB=memora

# ====== Redis ======
REDIS_URL=redis://localhost:6379/0

# ====== Whisper ======
WHISPER_MODEL=base.en          # tiny.en | base.en | small.en | medium.en | large-v3
WHISPER_DEVICE=cpu             # cpu | cuda
WHISPER_COMPUTE_TYPE=int8      # int8 | float16 | float32

# ====== Server ======
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ====== Agent ======
SHORT_TERM_WINDOW=10           # last N messages held in Redis per session
LONG_TERM_TOP_K=8              # semantic recall results
