# ====== LLM ======
LLM_PROVIDER=mistral           # mistral | google | openai | anthropic
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=               # get from https://console.mistral.ai/api-keys/  (free)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ====== Embeddings ======
EMBEDDING_PROVIDER=mistral     # mistral | google | openai
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIM=1024             # mistral-embed=1024, google text-embedding-004=768, openai text-embedding-3-small=1536

# ====== Postgres (pgvector) ======
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora
POSTGRES_DB=memora

# ====== Redis ======
REDIS_URL=redis://localhost:6379/0

# ====== Whisper ======
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ====== Server ======
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ====== Agent ======
SHORT_TERM_WINDOW=10
LONG_TERM_TOP_K=8
